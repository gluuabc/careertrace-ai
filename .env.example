AWS_REGION=us-east-1
BEDROCK_MODEL_CHEAP=amazon.nova-lite-v1:0
BEDROCK_MODEL_REASONING=global.anthropic.claude-sonnet-4-6
# Direct model used only for CountTokens; generation remains on the profiles above.
BEDROCK_COUNT_TOKENS_MODEL=anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_CONNECT_TIMEOUT_SECONDS=3
BEDROCK_READ_TIMEOUT_SECONDS=10
BEDROCK_MAX_ATTEMPTS=2
BEDROCK_RERANK_ENABLED=false
BEDROCK_RERANK_REGION=us-west-2
BEDROCK_RERANK_MODEL_ID=amazon.rerank-v1:0
# Canonical LangSmith tracing configuration. Legacy LANGCHAIN_* aliases are
# accepted by the SDK but are not the public CareerTrace configuration contract.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=CareerTrace

# SQL memory
DATABASE_URL=sqlite:///data/careertrace.db
# Optional deployment-only PEM text. When set for CockroachDB, CareerTrace
# writes it to a private runtime file and overrides DATABASE_URL sslrootcert.
COCKROACH_CA_CERT=
LANGGRAPH_CHECKPOINT_BACKEND=sqlite
LANGGRAPH_CHECKPOINT_DB=data/langgraph_checkpoints.sqlite
# Used only when LANGGRAPH_CHECKPOINT_BACKEND=cockroachdb.
LANGGRAPH_CHECKPOINT_SCHEMA=careertrace_checkpoints

# Private document storage
S3_BUCKET_NAME=careertrace-resumes
S3_REGION=us-east-1
MAX_DOCUMENT_SIZE_MIB=10

# Google OpenID Connect authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_COOKIE_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8501/oauth2callback

# Optional hackathon Judge workspace entry (set both values in deployment secrets)
JUDGE_DEMO_ENABLED=false
JUDGE_DEMO_ACCESS_CODE=

# Bounded Career Agent
JOB_SEARCH_DEFAULT_N=5
JOB_SEARCH_MAX_RESULTS=10
AGENT_MAX_ITERATIONS=6
AGENT_MAX_SOURCE_CALLS=12
AGENT_NO_NEW_RESULTS_STOP=2
AGENT_FINAL_MAX_TOKENS=384
SEARCH_SOURCES_PER_ITERATION=2

# Adaptive context management
# Leave blank to use the configured Bedrock model's known limit or a safe fallback.
CONTEXT_MODEL_LIMIT_TOKENS=
CONTEXT_COMPRESSION_TRIGGER_RATIO=0.75
CONTEXT_RESERVED_OUTPUT_TOKENS=4096
CONTEXT_SAFETY_MARGIN_TOKENS=8192

# Conversation-boundary memory extraction
MEMORY_EXTRACTION_MAX_INPUT_TOKENS=6000

# Retrieval behavior
RETRIEVAL_DEBUG_LOGGING=false
RETRIEVAL_CHUNK_TARGET_TOKENS=512
RETRIEVAL_CHUNK_MAX_TOKENS=768
RETRIEVAL_CHUNK_OVERLAP_TOKENS=64

# Agent evidence in the existing S3 bucket
EVIDENCE_S3_THRESHOLD_BYTES=65536
EVIDENCE_S3_ENABLED=true

# Optional public-source providers
PLAYWRIGHT_ENABLED=false
OPENALEX_API_KEY=
TAVILY_ENABLED=false
TAVILY_API_KEY=

# Optional developer-only, read-only Cockroach diagnostics (never an Agent tool)
COCKROACH_CLOUD_MCP_ENABLED=false
COCKROACH_CLOUD_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_CLOUD_CLUSTER_ID=
COCKROACH_CLOUD_MCP_API_KEY=
# Live integration tests require a separate disposable database.
COCKROACH_TEST_DATABASE_URL=
